#!/usr/bin/env python3
"""Theme every Zen profile from the wallpaper palette (run by rice-wall).

All profiles share the rice look: wallpaper surface colours, rounded corners,
Rubik, an accent bar on the active tab and an accent ring round the focused
URL bar. Each profile gets its own accent so they're easy to tell apart.
Preferred accents are taken in order, skipping any too close in hue to one
another profile already has (the palette changes with every wallpaper).

Writes <profile>/chrome/rice-zen.css, imports it from userChrome.css, and turns
on toolkit.legacyUserProfileCustomizations.stylesheets in user.js.
Takes effect the next time each profile starts.
"""
import colorsys
import configparser
import json
import re
import sys
from pathlib import Path

ZEN = Path.home() / ".zen"
PALETTE = Path.home() / ".cache/rice/zen-palette.json"

# profile name -> (preferred accents in order, background style)
#   background: "rice" = the wallpaper surface, "abyss" = deeper and darker
PROFILES = {
    "Denzel": (["primary"], "rice"),
    "Gaming": (["violet", "tertiary", "red"], "abyss"),
    "Work": (["green", "cyan", "secondary"], "rice"),
    "Default User": (["cyan", "yellow", "secondary"], "rice"),
    "ibexe": (["yellow", "red", "secondary"], "rice"),
}
FALLBACK = ["tertiary", "green", "cyan", "yellow", "red", "violet", "secondary"]
MIN_HUE_GAP = 25  # degrees


def hue(hex_color: str) -> float:
    r, g, b = (int(hex_color[i:i + 2], 16) / 255 for i in (1, 3, 5))
    return colorsys.rgb_to_hls(r, g, b)[0] * 360


def hue_gap(a: str, b: str) -> float:
    d = abs(hue(a) - hue(b)) % 360
    return min(d, 360 - d)


def profiles():
    ini = configparser.ConfigParser(interpolation=None)
    ini.read(ZEN / "profiles.ini")
    for section in ini.sections():
        if section.startswith("Profile") and "Path" in ini[section]:
            path = ini[section]["Path"]
            path = Path(path) if ini[section].get("IsRelative", "1") == "0" else ZEN / path
            if path.is_dir():
                yield ini[section]["Name"], path


def assign(names, accents):
    """Each profile's accent: its first preference that isn't too close to one already used."""
    taken, result = [], {}
    # known profiles first, in the order listed above, then any others
    order = [n for n in PROFILES if n in names] + sorted(n for n in names if n not in PROFILES)
    for name in order:
        prefs = PROFILES.get(name, ([], "rice"))[0] + FALLBACK
        choice = next((a for a in prefs if a in accents and all(hue_gap(accents[a]["accent"], accents[t]["accent"]) >= MIN_HUE_GAP for t in taken)), None)
        choice = choice or next(a for a in prefs if a in accents)
        taken.append(choice)
        result[name] = choice
    return result


def css(name: str, accent_name: str, a: dict, s: dict, style: str, mode: str) -> str:
    dark = mode != "light"
    if style == "abyss" and dark:
        bg = f"color-mix(in srgb, {s['surface_container_lowest']} 80%, {a['container']})"
        bg_raised = f"color-mix(in srgb, {s['surface_container_low']} 85%, {a['container']})"
    else:
        bg = f"color-mix(in srgb, {s['surface']} 86%, {a['accent']})"
        bg_raised = f"color-mix(in srgb, {s['surface_container']} 84%, {a['accent']})"
    return f"""/* Generated by rice-zen for the "{name}" profile (accent: {accent_name}).
   Re-generated on every wallpaper change; edit ~/dotfiles/bin/.local/bin/rice-zen instead. */

:root {{
  --rice-accent: {a['accent']};
  --rice-on-accent: {a['on_accent']};
  --rice-container: {a['container']};
  --rice-on-container: {a['on_container']};
  --rice-bg: {bg};
  --rice-bg-raised: {bg_raised};
  --rice-text: {s['on_surface']};
  --rice-text-dim: {s['on_surface_variant']};

  --zen-primary-color: var(--rice-accent) !important;
  --zen-colors-primary: var(--rice-container) !important;
  --zen-colors-secondary: color-mix(in srgb, var(--rice-container) 60%, var(--rice-bg)) !important;
  --zen-colors-tertiary: var(--rice-bg-raised) !important;
  --zen-colors-hover-bg: color-mix(in srgb, var(--rice-accent) 12%, transparent) !important;
  --zen-colors-primary-foreground: var(--rice-on-container) !important;
  --zen-colors-border: color-mix(in srgb, var(--rice-accent) 22%, transparent) !important;
  --zen-colors-border-contrast: color-mix(in srgb, var(--rice-accent) 35%, transparent) !important;
  --zen-colors-input-bg: var(--rice-bg-raised) !important;
  --zen-main-browser-background: var(--rice-bg) !important;
  --zen-main-browser-background-toolbar: var(--rice-bg) !important;
  --zen-dialog-background: var(--rice-bg-raised) !important;
  --zen-urlbar-background: var(--rice-bg-raised) !important;
  --zen-border-radius: 14px !important;
  --tab-background-color-selected: color-mix(in srgb, var(--rice-accent) 28%, transparent) !important;
  --toolbarbutton-icon-fill-attention: var(--rice-accent) !important;
  accent-color: var(--rice-accent) !important;
}}

/* Zen's JS sets the workspace gradient inline on these two elements */
#zen-browser-background, #zen-toolbar-background {{
  --zen-main-browser-background: var(--rice-bg) !important;
  --zen-main-browser-background-old: var(--rice-bg) !important;
  --zen-main-browser-background-toolbar: var(--rice-bg) !important;
  --zen-main-browser-background-toolbar-old: var(--rice-bg) !important;
  --zen-background-opacity: 1 !important;
}}

/* Same UI font as the rest of the rice */
#navigator-toolbox, #urlbar, menupopup, panel, #zen-sidebar-top-buttons, .tab-label {{
  font-family: "Rubik", sans-serif !important;
}}

/* Active tab: accent bar on its left edge */
.tabbrowser-tab[selected] .tab-background {{
  box-shadow: inset 3px 0 0 var(--rice-accent) !important;
}}
.tabbrowser-tab[selected] .tab-label {{
  color: var(--rice-text) !important;
  font-weight: 500 !important;
}}

/* Focused URL bar: accent ring */
#urlbar[focused] #urlbar-background,
#urlbar[open] #urlbar-background {{
  outline: 2px solid var(--rice-accent) !important;
  outline-offset: -2px !important;
}}

/* Text selection and links in the UI */
::selection {{
  background-color: var(--rice-container) !important;
  color: var(--rice-on-container) !important;
}}
"""


def ensure_import(chrome: Path) -> None:
    user_chrome = chrome / "userChrome.css"
    line = '@import "rice-zen.css";'
    text = user_chrome.read_text() if user_chrome.exists() else ""
    if line not in text:
        user_chrome.write_text(line + "\n" + text)  # @import must come first


def ensure_pref(profile: Path) -> None:
    user_js = profile / "user.js"
    pref = 'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);'
    text = user_js.read_text() if user_js.exists() else ""
    if "toolkit.legacyUserProfileCustomizations.stylesheets" not in text:
        user_js.write_text(text + ("" if text.endswith("\n") or not text else "\n") + pref + "\n")


def main() -> int:
    if not PALETTE.exists():
        print("rice-zen: no palette yet (run rice-wall)", file=sys.stderr)
        return 1
    pal = json.loads(PALETTE.read_text())
    accents = {k: v for k, v in pal["accents"].items() if re.fullmatch(r"#[0-9a-fA-F]{6}", v.get("accent", ""))}
    found = dict(profiles())
    chosen = assign(list(found), accents)
    for name, path in found.items():
        style = PROFILES.get(name, ([], "rice"))[1]
        chrome = path / "chrome"
        chrome.mkdir(exist_ok=True)
        (chrome / "rice-zen.css").write_text(css(name, chosen[name], accents[chosen[name]], pal["surfaces"], style, pal.get("mode", "dark")))
        ensure_import(chrome)
        ensure_pref(path)
        if "-q" not in sys.argv:
            print(f"{name:16} {chosen[name]:10} {accents[chosen[name]]['accent']}  {style}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
